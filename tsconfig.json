{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,

        // STRICTNESS LEVEL 100
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "skipLibCheck": true,
        "baseUrl": "."
    },
    "exclude": ["node_modules", "dist"],
    "references": [],
    "include": [
        "vitest.config.ts",
        "vitest.workspace.ts",
        "vitest.audit.config.ts"
    ]
}
