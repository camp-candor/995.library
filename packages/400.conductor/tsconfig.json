{
    "extends": "../../apps/995.library/tsconfig-base.json",
    "compilerOptions": {
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./",
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "dist"]
}
